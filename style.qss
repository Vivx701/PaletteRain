QWidget {
    background-color: #020618;
    color: #E2E8F0;
    font-family: "Segoe UI";
    font-size: 15pt;
}


QWidget#Gameover QLabel#tittle {
    color: #ff4444;
    font-size: 50px;
    font-weight: bold;
    margin-top: 10px;
    margin-bottom: 8px;
    text-align: center;
}

QWidget#Gameover QLabel#msg {
    color: #E2E8F0;
    font-size: 25px;
    margin-top: 4px;
    text-align: center;
}

